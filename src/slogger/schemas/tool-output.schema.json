{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OmkarKabadagi5823/slogger/schemas/tool-output.schema.json",
  "title": "slogger tool output",
  "description": "JSON contracts for slogger.tools aggregates and list _meta control lines. schema_version is 1; additive optional keys stay on version 1.",
  "$defs": {
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "string_int_map": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "duration_stats": {
      "type": "object",
      "required": ["count", "min", "max", "mean", "p50", "p95", "p99"],
      "properties": {
        "count": { "type": "integer" },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "mean": { "type": ["number", "null"] },
        "p50": { "type": ["number", "null"] },
        "p95": { "type": ["number", "null"] },
        "p99": { "type": ["number", "null"] },
        "percentiles_capped": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "delta": {
      "type": "object",
      "required": ["before", "after", "abs", "pct"],
      "properties": {
        "before": { "type": ["number", "null"] },
        "after": { "type": ["number", "null"] },
        "abs": { "type": ["number", "null"] },
        "pct": { "type": ["number", "null"] },
        "approximate": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "page_meta": {
      "type": "object",
      "required": ["schema_version", "returned", "skipped_lines", "next_cursor", "warnings"],
      "properties": {
        "schema_version": { "const": 1 },
        "returned": { "type": "integer" },
        "skipped_lines": { "type": "integer" },
        "next_cursor": { "type": ["string", "null"] },
        "warnings": { "$ref": "#/$defs/warnings" },
        "anchor": { "type": "string" },
        "trace_id": { "type": ["string", "null"] },
        "before": { "type": "integer" },
        "after": { "type": "integer" },
        "trace_records": { "type": "integer" },
        "trace_capped": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "watch_meta": {
      "type": "object",
      "required": ["schema_version", "matched", "elapsed_ms", "records_seen"],
      "properties": {
        "schema_version": { "const": 1 },
        "matched": { "type": "boolean" },
        "elapsed_ms": { "type": "number" },
        "records_seen": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "sources",
        "records",
        "skipped_lines",
        "first_timestamp",
        "last_timestamp",
        "levels",
        "loggers",
        "loggers_capped",
        "spans",
        "spans_capped",
        "traces",
        "traces_capped"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "sources": { "type": "array" },
        "records": { "type": "integer" },
        "skipped_lines": { "type": "integer" },
        "first_timestamp": { "type": ["string", "null"] },
        "last_timestamp": { "type": ["string", "null"] },
        "levels": { "$ref": "#/$defs/string_int_map" },
        "loggers": { "type": "array", "items": { "type": "string" } },
        "loggers_capped": { "type": "boolean" },
        "spans": { "type": "array", "items": { "type": "string" } },
        "spans_capped": { "type": "boolean" },
        "traces": { "type": "integer" },
        "traces_capped": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "fields": {
      "type": "object",
      "required": ["schema_version", "scanned", "scan_capped", "keys"],
      "properties": {
        "schema_version": { "const": 1 },
        "scanned": { "type": "integer" },
        "scan_capped": { "type": "boolean" },
        "keys": { "type": "object" }
      },
      "additionalProperties": true
    },
    "fields_top": {
      "type": "object",
      "required": ["schema_version", "key", "scanned", "top"],
      "properties": {
        "schema_version": { "const": 1 },
        "key": { "type": "string" },
        "scanned": { "type": "integer" },
        "top": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "count"],
            "properties": {
              "value": true,
              "count": { "type": "integer" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "schema_version",
        "order",
        "matched",
        "skipped_lines",
        "levels",
        "loggers",
        "group_by",
        "groups",
        "groups_capped",
        "ungrouped",
        "warnings"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "order": { "type": "string" },
        "matched": { "type": "integer" },
        "skipped_lines": { "type": "integer" },
        "levels": { "$ref": "#/$defs/string_int_map" },
        "loggers": { "$ref": "#/$defs/string_int_map" },
        "group_by": { "type": ["string", "null"] },
        "groups": { "type": "array" },
        "groups_capped": { "type": "boolean" },
        "ungrouped": { "type": "integer" },
        "warnings": { "$ref": "#/$defs/warnings" },
        "first_id": { "type": ["string", "null"] },
        "last_id": { "type": ["string", "null"] },
        "first_timestamp": { "type": ["string", "null"] },
        "last_timestamp": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "tree": {
      "type": "object",
      "required": [
        "schema_version",
        "order",
        "group_by",
        "total",
        "returned",
        "truncated",
        "groups_capped",
        "ungrouped",
        "skipped_lines",
        "traces",
        "warnings"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "order": { "type": "string" },
        "group_by": { "type": ["string", "null"] },
        "total": { "type": "integer" },
        "returned": { "type": "integer" },
        "truncated": { "type": "boolean" },
        "groups_capped": { "type": "boolean" },
        "ungrouped": { "type": "integer" },
        "skipped_lines": { "type": "integer" },
        "traces": { "type": "array" },
        "warnings": { "$ref": "#/$defs/warnings" }
      },
      "additionalProperties": true
    },
    "stats": {
      "type": "object",
      "required": [
        "schema_version",
        "order",
        "records",
        "skipped_lines",
        "group_by",
        "spans",
        "bucket",
        "totals",
        "groups",
        "groups_capped",
        "ungrouped",
        "warnings"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "order": { "type": "string" },
        "records": { "type": "integer" },
        "skipped_lines": { "type": "integer" },
        "group_by": { "type": ["string", "null"] },
        "spans": { "type": "boolean" },
        "bucket": { "type": ["string", "null"] },
        "totals": { "type": "object" },
        "groups": { "type": "array" },
        "groups_capped": { "type": "boolean" },
        "ungrouped": { "type": "integer" },
        "warnings": { "$ref": "#/$defs/warnings" }
      },
      "additionalProperties": true
    },
    "errors": {
      "type": "object",
      "required": [
        "schema_version",
        "order",
        "records_scanned",
        "skipped_lines",
        "error_records",
        "failed_spans",
        "total_groups",
        "returned",
        "groups_capped",
        "groups",
        "warnings"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "order": { "type": "string" },
        "records_scanned": { "type": "integer" },
        "skipped_lines": { "type": "integer" },
        "error_records": { "type": "integer" },
        "failed_spans": { "type": "integer" },
        "total_groups": { "type": "integer" },
        "returned": { "type": "integer" },
        "groups_capped": { "type": "boolean" },
        "groups": { "type": "array" },
        "warnings": { "$ref": "#/$defs/warnings" }
      },
      "additionalProperties": true
    },
    "validate": {
      "type": "object",
      "required": [
        "schema_version",
        "sources",
        "lines",
        "valid",
        "invalid",
        "kinds",
        "diagnostics",
        "diagnostics_capped"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "sources": { "type": "array" },
        "lines": { "type": "integer" },
        "valid": { "type": "integer" },
        "invalid": { "type": "integer" },
        "kinds": { "$ref": "#/$defs/string_int_map" },
        "diagnostics": { "type": "array" },
        "diagnostics_capped": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "diff": {
      "type": "object",
      "required": [
        "schema_version",
        "order",
        "group_by",
        "spans",
        "before",
        "after",
        "totals",
        "groups",
        "added",
        "removed",
        "truncated",
        "warnings"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "order": { "type": "string" },
        "group_by": { "type": ["string", "null"] },
        "spans": { "type": "boolean" },
        "before": { "type": "object" },
        "after": { "type": "object" },
        "totals": { "type": "object" },
        "groups": { "type": "array" },
        "added": { "type": "array" },
        "removed": { "type": "array" },
        "truncated": { "type": "boolean" },
        "warnings": { "$ref": "#/$defs/warnings" }
      },
      "additionalProperties": true
    },
    "trace": {
      "type": "object",
      "required": [
        "schema_version",
        "trace_id",
        "status",
        "started",
        "ended",
        "duration_ms",
        "spans",
        "warnings"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "trace_id": { "type": ["string", "null"] },
        "group": { "type": ["object", "null"] },
        "status": { "type": "string" },
        "started": { "type": ["string", "null"] },
        "ended": { "type": ["string", "null"] },
        "duration_ms": { "type": ["number", "null"] },
        "spans": { "type": "array" },
        "logs": { "type": "array" },
        "warnings": { "$ref": "#/$defs/warnings" },
        "matched_records": { "type": ["integer", "null"] },
        "matched_traces": { "type": ["integer", "null"] }
      },
      "additionalProperties": true
    },
    "explain": {
      "type": "object",
      "required": ["schema_version", "filters", "notes"],
      "properties": {
        "schema_version": { "const": 1 },
        "filters": {
          "type": "object",
          "required": [
            "level_min",
            "level_exact",
            "logger",
            "where",
            "has",
            "missing",
            "grep",
            "since",
            "until",
            "span",
            "trace",
            "exclude_events"
          ]
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  }
}
