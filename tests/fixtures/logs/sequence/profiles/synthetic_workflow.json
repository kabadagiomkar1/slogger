{
  "schema_version": 2,
  "name": "synthetic-workflow",
  "profile_version": "2",
  "episode": {
    "key": ["workflow_id"],
    "fallback_keys": [],
    "start": ["message=workflow.start"],
    "end": ["message=workflow.end"],
    "complete_when": {"end": true}
  },
  "variant_key": null,
  "occurrence_key": ["step_occurrence_id", "attempt"],
  "spans": [
    {
      "role": "episode",
      "parent": null,
      "bounds": "group"
    }
  ],
  "span_events": "as_steps",
  "rules": [
    {"id": "bg", "category": "background", "when": ["logger~\\.bg$"], "on": "episode"},
    {"id": "bg_kind", "category": "background", "when": ["kind=background"], "on": "episode"},
    {"id": "abort", "category": "abort", "when": ["kind=workflow.abort"], "token": "message", "on": "episode"},
    {"id": "err", "category": "error", "when": ["kind=step.failed"], "token": "error_code", "on": "episode"},
    {"id": "observe", "category": "observation", "when": ["kind=observation"], "token": "message", "token_suffix": "slide_present", "on": "episode"},
    {"id": "step_entry", "category": "step", "when": ["kind=step.entry"], "token": "operation_type", "on": "episode"},
    {"id": "workflow_msg", "category": "other", "when": ["kind~^workflow\\."], "on": "episode"}
  ],
  "outcome": {
    "span_role": "episode",
    "rules": [],
    "episode": {
      "field": "workflow_outcome",
      "on": ["message=workflow.end"]
    }
  },
  "links": {
    "recovery_of": "recovery_of",
    "triggered_recovery": "triggered_recovery_id"
  },
  "keep_attrs": [
    "span",
    "status",
    "duration_ms",
    "error_code",
    "attempt",
    "step_occurrence_id",
    "workflow_outcome",
    "recovery_of",
    "triggered_recovery_id",
    "slide_present",
    "operation_type",
    "level",
    "kind"
  ],
  "path": {
    "app": ["episode"]
  }
}
